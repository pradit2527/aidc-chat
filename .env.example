# Chatwoot ของ AIDC Tech
CHATWOOT_BASE_URL=https://chatwoot.aidclaos.com

# Website token ของ inbox "COSI Hotel Support"
# Chatwoot → Settings → Inboxes → COSI Hotel Support → Configuration → โค้ด widget (website_token)
# ค่านี้เป็นสาธารณะ (อยู่ในโค้ดหน้าเว็บอยู่แล้ว)
CHATWOOT_WEBSITE_TOKEN=

# HMAC token สำหรับยืนยันตัวตนผู้ใช้ — เป็นความลับ ห้ามส่งออกไปฝั่ง browser
# Chatwoot → Settings → Inboxes → COSI Hotel Support → Configuration → Identity Validation
# ปล่อยว่างได้ (widget ยังใช้ได้ แต่ไม่ยืนยันตัวตน)
CHATWOOT_HMAC_TOKEN=

# คอนโซลไอที (/admin)
# คีย์เข้ารหัสคุกกี้เซสชัน — สร้างด้วย: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
# account / inbox / prefix ของป้ายกำกับ ใน Chatwoot (ค่าเริ่มต้นตามที่ตั้งไว้แล้ว)
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=5
CHATWOOT_LABEL_PREFIX=cosi-

# URL สาธารณะของพอร์ทัลพนักงาน ใช้สร้าง QR Code ที่หน้าแรก (/) (ใส่เมื่อมีโดเมนจริง)
PORTAL_PUBLIC_URL=

# คำทักทายอัตโนมัติ "ทุกครั้งที่มีแชทใหม่" (ส่งในชื่อเจ้าหน้าที่ที่เปิดคอนโซลอยู่ — ครอบคลุมคนเก่าที่พิมพ์ต่อในเคสเดิม)
# ค่าเริ่มต้น: ສະບາຍດີ ພະແນກໄອທີຍິນດີໃຫ້ບໍລິການ ກະລຸນາບອກພວກເຮົາກ່ຽວກັບບັນຫາຂອງທ່ານ   | ใส่ off เพื่อปิด
# ADMIN_AUTO_GREETING=
# เงียบนานเกินกี่นาทีแล้วพิมพ์มาใหม่จึงนับเป็นแชทใหม่ (ค่าเริ่มต้น 60)
# ADMIN_GREETING_IDLE_MIN=60

# ทะเบียน Ticket + ประวัติ + สถิติ (Neon Postgres) — ปล่อยว่างได้ (ระบบจะคำนวณเลขตั๋วจาก Chatwoot แทน และไม่มีหน้า /admin/stats)
# Neon → Project → Branch → Connection string (เลือก pooled) แล้วรัน: npm run db:migrate
DATABASE_URL=

# (ไม่บังคับ) access token ของ agent กลางใน Chatwoot (Profile Settings → Access Token) — ให้แอดมินที่สร้างใน /admin/users ใช้คอนโซลแชทได้
# ข้อความที่ตอบจะขึ้นในชื่อ agent กลาง และระบบใส่ชื่อผู้ตอบจริงต่อท้ายให้ · ว่าง = แอดมินกลุ่มนี้ใช้แชทไม่ได้
CHATWOOT_AGENT_TOKEN=
# ระบบแชท (/chat, /admin/chat, การ์ด "ລະບົບແຊັດ" ในหน้าหลัก) — ซ่อนไว้ตามค่าเริ่มต้น ให้เหลือเฉพาะระบบแจ้งปัญหา; ใส่ 1 เพื่อเปิดกลับ
# CHAT_ENABLED=1


# แจ้งเตือนเข้า "กลุ่ม" WhatsApp ของทีมไอที — เชื่อมต่อแบบอุปกรณ์ (เหมือน WhatsApp Web, ไลบรารี Baileys) เพราะ API ทางการ/Twilio ส่งเข้ากลุ่มไม่ได้
# ใส่ 1 แล้วไปสแกน QR ที่ /admin/whatsapp ด้วยเบอร์ของทีมไอที (ต้องอยู่ในกลุ่ม) แล้วเลือกกลุ่ม; คีย์ของอุปกรณ์เก็บใต้ WHATSAPP_DIR (ค่าเริ่มต้น ./data/whatsapp)
WHATSAPP_DEVICE=1
# WHATSAPP_DIR=./data/whatsapp
# ชื่อกลุ่มที่ระบบเลือกให้เองหลังสแกน (ค่าเริ่มต้น IT support cosi) — เปลี่ยนได้ถ้ากลุ่มชื่ออื่น
# WHATSAPP_GROUP_NAME=IT support cosi

# คำนำหน้าเลขตั๋ว = ชื่อย่อบริษัทที่แจ้ง ตัวพิมพ์เล็ก (ค่าเริ่มต้น cosi → cosi-21-10-2026-013); เปลี่ยนเมื่อใช้กับบริษัทอื่น
# TICKET_PREFIX=cosi
